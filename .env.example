# Alternativa a src/firebase.config.ts: copia este archivo como .env.local y rellena
# los valores de tu proyecto (Consola Firebase → Configuración del proyecto → Tus apps → App web).
# Si un valor está aquí, tiene prioridad sobre el de src/firebase.config.ts.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
