{
  "name": "almacen",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "backup": "node scripts/backup.mjs backup-output",
    "restore": "node scripts/restore.mjs",
    "set-role": "node scripts/set-role.mjs",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-almacen",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes",
    "deploy": "npm run build && firebase deploy --only hosting,firestore",
    "test:rules": "npm --prefix tests install --no-audit --no-fund && npm --prefix tests test",
    "dev:emulator": "firebase emulators:exec --only auth,firestore --project demo-almacen --ui \"vite --mode emulator\"",
    "report": "node scripts/daily-report.mjs",
    "report:preview": "node scripts/daily-report.mjs --dry-run"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "firebase": "^13.4.0",
    "lucide-react": "^1.76.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "recharts": "^3.11.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "firebase-admin": "^14.5.1",
    "firebase-tools": "^15.37.0",
    "nodemailer": "^10.6.0",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
